{
  "name": "react-native-basalt",
  "version": "0.0.0",
  "private": true,
  "description": "React Native on the desktop, over React Native's own C++ core rather than a fork. The shared half: the platform module, the Metro configuration that resolves it, the bundler, and the C++ that is not about a toolkit.",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./metro-config": "./metro-config.js",
    "./cli/bundleWithAssets": "./cli/bundleWithAssets.js",
    "./cli/desktop": "./cli/desktop.js",
    "./cli/metro": "./cli/metro.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cli",
    "native",
    "metro-config.js",
    "react-native.config.js",
    "supported-versions.json"
  ],
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0"
  },
  "bin": {
    "basalt-bundle": "./cli/bundle-cli.js"
  }
}
